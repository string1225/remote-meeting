{
  "name": "remote-meeting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Low-load shared USB camera and laptop picture-in-picture host with remote controls",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/browser.mjs",
    "test:meeting-ui": "node test/meeting-ui-browser.mjs",
    "test:accounts": "node test/accounts-browser.mjs",
    "test:host-accounts": "node test/host-accounts-browser.mjs",
    "check": "node test/check.mjs",
    "host": "node host/index.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "node-turn": "^0.0.6",
    "playwright": "^1.55.0"
  }
}
