HOST=127.0.0.1
PORT=3000
# First start only. Set a 6-128 character password; subsequent changes use the web account manager.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-your-password
# Contains salted password hashes; never commit this file.
USERS_FILE=.local/users.json
# Use /meeting/ when deployed behind the provided Nginx configuration.
COOKIE_PATH=/
# A separate machine credential, shared only with .local/host.json on the host PC.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HOST_AGENT_KEY=replace-with-a-random-host-agent-key
# HTTPS origin(s), comma separated; empty allows localhost development only.
ALLOWED_ORIGINS=
TRUST_PROXY=false
ROOM_TTL_HOURS=8

# Media always traverses the project's 139 server; no direct ICE fallback.
TURN_URLS=turn:139.224.12.141:3478?transport=udp,turn:139.224.12.141:3478?transport=tcp
# Shared with coturn static-auth-secret. Never send this secret to browsers.
# deploy/install-turn.sh generates/preserves it in /etc/remote-meeting.env.
TURN_SECRET=replace-with-a-random-turn-secret-at-least-32-characters
ICE_TRANSPORT_POLICY=relay
