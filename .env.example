HOST=127.0.0.1
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_KEY=replace-with-at-least-24-random-characters
# HTTPS origin(s), comma separated; empty allows localhost development only.
ALLOWED_ORIGINS=
TRUST_PROXY=false
STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# Optional external TURN. Do NOT use the low-bandwidth signaling server as TURN.
TURN_URLS=
TURN_SECRET=
TURN_USERNAME_PREFIX=meeting
ROOM_TTL_HOURS=8
