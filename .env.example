HOST=127.0.0.1
PORT=3000
# First start only. Set a 6-128 character password; subsequent changes use the web account manager.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-your-password
# Contains salted password hashes; never commit this file.
USERS_FILE=.local/users.json
# Use /meeting/ when deployed behind the provided Nginx configuration.
COOKIE_PATH=/
# A separate machine credential, shared only with .local/host.json on the host PC.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HOST_AGENT_KEY=replace-with-a-random-host-agent-key
# HTTPS origin(s), comma separated; empty allows localhost development only.
ALLOWED_ORIGINS=
TRUST_PROXY=false
STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# Optional external TURN. Do NOT use the low-bandwidth signaling server as TURN.
TURN_URLS=
TURN_SECRET=
TURN_USERNAME_PREFIX=meeting
ROOM_TTL_HOURS=8
